# Android fstab file for Samsung Galaxy J3 2017 (Exynos 7570)
# <src>                                       <mnt_point>  <type>  <mnt_flags and options>  <fs_mgr_flags>

/dev/block/platform/13540000.dwmmc0/by-name/BOOT       /boot       emmc    defaults    recoveryonly
/dev/block/platform/13540000.dwmmc0/by-name/RECOVERY   /recovery   emmc    defaults    recoveryonly
/dev/block/platform/13540000.dwmmc0/by-name/SYSTEM     /system     ext4    ro,barrier=1    wait
/dev/block/platform/13540000.dwmmc0/by-name/CACHE      /cache      ext4    noatime,nosuid,nodev,barrier=1    wait,check
/dev/block/platform/13540000.dwmmc0/by-name/USERDATA   /data       ext4    noatime,nosuid,nodev,barrier=1,noauto_da_alloc    wait,check,encryptable=footer,length=-16384
/dev/block/platform/13540000.dwmmc0/by-name/EFS        /efs        ext4    noatime,nosuid,nodev,barrier=1    wait,check
/dev/block/platform/13540000.dwmmc0/by-name/VENDOR     /vendor     ext4    ro,barrier=1    wait

# VOLD
/devices/platform/13550000.dwmmc2/mmc_host/*           auto        vfat    defaults    voldmanaged=sdcard1:auto,encryptable=userdata
/devices/platform/13600000.usb/13600000.dwc3/*         auto        vfat    defaults    voldmanaged=usb:auto
